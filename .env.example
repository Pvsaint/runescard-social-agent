# ─────────────────────────────────────────────
#  LLM — pick one
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Which LLM to use: "gemini" or "openai"
LLM_PROVIDER=gemini

# ─────────────────────────────────────────────
#  Twitter / X  (v2 API, OAuth 1.0a)
#  Get keys at: https://developer.twitter.com
# ─────────────────────────────────────────────
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ─────────────────────────────────────────────
#  Farcaster (via Neynar — no local wallet needed)
#  Get keys at: https://neynar.com
# ─────────────────────────────────────────────
NEYNAR_API_KEY=
FARCASTER_SIGNER_UUID=

# ─────────────────────────────────────────────
#  Agent behaviour
# ─────────────────────────────────────────────
# Comma-separated list of enabled platforms: twitter, farcaster
ENABLED_PLATFORMS=twitter,farcaster

# Posts per day (used by the scheduler)
POST_FREQUENCY=3

# Set to "true" to generate content without actually posting
DRY_RUN=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
